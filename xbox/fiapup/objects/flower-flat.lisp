; flower-flat — a meadow flower: a stem, five petals round a middle. The
; game stamps it into a chunk's sketch many times; the petals are keyed ink
; (255 0 255) so each stamp can give them its own colour.

(ink 88 140 70) (limb 0 0 0 0 11 0 .8)
(move 0 12 0
  (ink 255 0 255)
  (radial y 5 (move 2.4 0 0 (ball 0 0 0 1.9)))
  (nudge -.5 (ink 255 214 84) (ball 0 .4 0 1.3)))

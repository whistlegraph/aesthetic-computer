<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>oskiewar</string>
  <key>CFBundleIconFile</key><string>Oskiewar</string>
  <key>CFBundleIdentifier</key><string>computer.aesthetic.oskiewar</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>oskiewar</string>
  <key>CFBundleDisplayName</key><string>oskiewar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <!-- Both platforms answer to one App Store Connect record, and the Fastfile
       names a single OSKIEWAR_BUILD_NUMBER for `ship`. This has to agree with
       apple/oskiewar/Info.plist or the mac lane asks the store for a build
       that was only ever uploaded from the phone side. Bump both together. -->
  <key>CFBundleVersion</key><string>7</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSHumanReadableCopyright</key><string>© 2026 Aesthetic Computer</string>
  <!-- OscSender broadcasts the match's own events on UDP 51338 so a DAW
       across the desk can score the fight. macOS 15 asks before the first
       packet leaves for the LAN; this is the sentence it shows. Denying it
       costs the OSC feed and nothing else — the game plays on. -->
  <key>NSLocalNetworkUsageDescription</key><string>oskiewar sends its match events to music tools on your local network.</string>
  <!-- The game speaks HTTPS and nothing else, which is exempt encryption.
       Declaring it here answers the export-compliance question once instead of
       at every upload. -->
  <key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>

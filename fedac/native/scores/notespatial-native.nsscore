{"name":"Note(s)pat(ial) Native","bpm":112,"geometry":"ring","seats":6,"dur":788.4664,"gain":0.36,"swing":0.6,"movements":[{"name":"I · Appear","sub":"one sine breathes at the front, then walks the ring","t0":0,"t1":104.1736,"level":0.3},{"name":"II · Ring","sub":"the pulse arrives front and back; the walk becomes a swing","t0":104.1736,"t1":189.8878,"level":0.55},{"name":"III · Echoes","sub":"every note is answered from across the room","t0":189.8878,"t1":309.8878,"level":0.75},{"name":"IV · Climb","sub":"four registers, an octave apart; the top line glides against the walk","t0":309.8878,"t1":447.0307,"level":0.9},{"name":"V · Lift","sub":"up a whole step: the theme orbits over the floor","t0":447.0307,"t1":584.1736,"level":1},{"name":"VI · Return","sub":"back home; the echoes thin, the ring narrows to the front","t0":584.1736,"t1":721.3164,"level":0.6},{"name":"VII · Vanish","sub":"one slow lap the other way, then one laptop","t0":721.3164,"t1":788.4664,"level":0.3}],"lanes":[{"name":"voice 1","color":[255,205,110],"az":0,"events":[{"t":0,"dur":3.2,"hz":261.63,"g":0.5,"wave":"sine","attack":0.35,"decay":0.9},{"t":5.8,"dur":3.2,"hz":261.63,"g":0.5,"wave":"sine","attack":0.35,"decay":0.9},{"t":11.2,"dur":3.4,"hz":392,"g":0.5,"wave":"sine","attack":0.35,"decay":0.9},{"t":16.4,"dur":3,"hz":329.63,"g":0.5,"wave":"sine","attack":0.35,"decay":0.9},{"t":21,"dur":3.6,"hz":261.63,"g":0.5,"wave":"sine","attack":0.35,"decay":0.9},{"t":26.6,"dur":1.426,"hz":261.63,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":37.14,"dur":1.3814,"hz":1046.5,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":47.3506,"dur":1.3084,"hz":659.26,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":57.0212,"dur":1.2185,"hz":392,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":66.0276,"dur":1.1156,"hz":261.63,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":74.2733,"dur":1.0018,"hz":1046.5,"g":0.46,"wave":"sine","attack":0.012,"decay":0.08},{"t":81.6777,"dur":0.878
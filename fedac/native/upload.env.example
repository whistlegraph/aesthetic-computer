# Private OS release upload configuration. Provision from the vault into
# ~/.config/aesthetic-computer/native-upload.env (chmod 600), or on a build
# server into /etc/aesthetic-computer/native-upload.env with service access.
# AC_NATIVE_UPLOAD_ENV can select another private path. Never commit credentials.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=releases-aesthetic-computer

        "beat": 22,
        "name": "frisbee: Sophia"
      },
      {
        "beat": 28,
        "name": "M O O N · the moon is up"
      },
      {
        "beat": 40,
        "name": "L I D · the lid is down"
      },
      {
        "beat": 52,
        "name": "C O F F E E · a cup of coffee"
      },
      {
        "beat": 64,
        "name": "neo: that is how you spell it"
      },
      {
        "beat": 72,
        "name": "S O P H I A, both at once"
      },
      {
        "beat": 76,
        "name": "frisbee: Sophia"
      }
    ]
  },

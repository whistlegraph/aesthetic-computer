{
  "title": "The MacNeoPolitan Trio — The record",
  "composer": "The machines, arr. compose-the-record.mjs",
  "bpm": 104,
  "machines": 3,
  "lead": 0,
  "description": "A hocket on the numbers the machines keep: 6,305 logins, 111 reboots, 2,019 commits, 212 and 85 battery cycles, 00:37 and 00:43, 48 days apart, and the twenty second of September, when the third one was named. Each number is broken across the three laptops one syllable at a time — neo, frisbee, blueberry — so no machine says a whole number and the room assembles it; every line lands on its last word in unison, in three registers. blueberry keeps a low dm clock in the gaps, and all three hold the landing chord at the end. 4/4, 104 bpm, 108 beats.",
  "arrangement": {
    "total": 108,
    "meter": "4/4",
    "style": "hocket",
    "sections": [
      {
        "beat": 0,
        "name": "Clock (count in)"
      },
      {
        "beat": 4,
        "name": "six thousand three hundred five logins"
      },
      {
        "beat": 14.5,
        "name": "one hundred eleven reboots"
      },
      {
        "beat": 24.5,
        "name": "two thousand nineteen commits"
      },
      {
        "beat": 34,
        "name": "two hundred twelve cycles and eighty five cycles"
      },
      {
        "beat": 47,
        "name": "oh oh thirty seven was the first minute"
      },
      {
        "beat": 58.5,
        "name": "oh oh forty three was the second"
      },
      {
        "beat": 69,
        "name": "forty eight days between the two birthdays"
      },
      {
        "beat": 80,
        "name": "the third one was named on the twenty second of September"
      },
      {
        "beat": 94,
        "name": "nobody chose these numbers"
      }
    ]
  },

      },
      {
        "beat": 64,
        "name": "All: open me"
      },
      {
        "beat": 72,
        "name": "neo: your name is on my screen"
      },
      {
        "beat": 80,
        "name": "blueberry: I have not seen it"
      },
      {
        "beat": 88,
        "name": "frisbee: open me"
      },
      {

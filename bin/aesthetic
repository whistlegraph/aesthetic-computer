#!/usr/bin/env bash

set -euo pipefail

VERSION="0.3.0"
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_directory="$(cd "$(dirname "$script_path")" && pwd -P)"
    link_target="$(readlink "$script_path")"
    if [[ "$link_target" == /* ]]; then
        script_path="$link_target"
    else
        script_path="$script_directory/$link_target"
    fi
done
PROJECT_DIR="$(cd "$(dirname "$script_path")/.." && pwd -P)"

usage() {
    cat <<'EOF'
Usage: ac [directory]
       aesthetic [directory]
       aesthetic doctor
       aesthetic login | logout | whoami
       aesthetic publish <file> [slug]

Open the Aesthetic Code terminal interface in a workspace, or manage the
shared Aesthetic Computer sign-in (~/.ac-token) and publish a piece under
your @handle at https://aesthetic.computer/@handle/slug.
EOF
}

fail() {
    printf 'aesthetic: %s\n' "$*" >&2
    exit 1
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

doctor() {
    printf 'Aesthetic Code %s\n' "$VERSION"
    printf 'interface: %s\n' "$PROJECT_DIR/src/tui.mjs"
    printf 'control plane: local\n'
    printf 'telemetry: off\n'

    if has_command node; then
        printf 'node: %s\n' "$(command -v node)"
    else
        printf 'node: not installed\n'
    fi

    if has_command codex; then
        printf 'engine bridge: ready\n'
    else
        printf 'engine bridge: unavailable (install Codex)\n'
    fi

    if has_command node; then
        printf 'account: %s\n' "$(node "$PROJECT_DIR/src/cli.mjs" whoami 2>/dev/null || printf 'not signed in')"
    fi
}

case "${1:-}" in
    --help|-h|help)
        usage
        exit 0
        ;;
    --version|-V|version)
        printf 'Aesthetic Code %s\n' "$VERSION"
        exit 0
        ;;
    doctor)
        [[ $# -eq 1 ]] || fail "doctor takes no arguments"
        doctor
        exit 0
        ;;
    login|logout|whoami|publish)
        has_command node || fail "Node.js is required"
        exec node "$PROJECT_DIR/src/cli.mjs" "$@"
        ;;
esac

target_directory=""
resume_thread=""
initial_prompt=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --resume)
            [[ $# -ge 2 ]] || fail "--resume requires a thread id"
            [[ "$2" =~ ^[0-9A-Fa-f-]{36}$ ]] || fail "invalid thread id"
            resume_thread="$2"
            shift 2
            ;;
        --prompt)
            [[ $# -ge 2 ]] || fail "--prompt requires text"
            [[ ${#2} -le 4000 ]] || fail "prompt exceeds 4000 characters"
            initial_prompt="$2"
            shift 2
            ;;
        --)
            shift
            [[ $# -le 1 ]] || fail "expected one workspace directory"
            if [[ $# -eq 1 ]]; then target_directory="$1"; fi
            shift $(( $# > 0 ? 1 : 0 ))
            ;;
        -*)
            fail "unknown option: $1"
            ;;
        *)
            [[ -z "$target_directory" ]] || fail "expected one workspace directory; run aesthetic --help"
            target_directory="$1"
            shift
            ;;
    esac
done

target_directory="${target_directory:-$PWD}"
[[ -d "$target_directory" ]] || fail "directory does not exist: $target_directory"
target_directory="$(cd "$target_directory" && pwd -P)"

has_command node || fail "Node.js is required"
has_command codex || fail "the Aesthetic Code engine bridge is not installed"

if [[ "${AESTHETIC_CODE_DRY_RUN:-0}" == "1" ]]; then
    printf 'interface=aesthetic-code\n'
    printf 'directory=%s\n' "$target_directory"
    printf 'resume=%s\n' "$([[ -n "$resume_thread" ]] && printf yes || printf no)"
    printf 'initial_prompt=%s\n' "$([[ -n "$initial_prompt" ]] && printf yes || printf no)"
    exit 0
fi

[[ -t 0 && -t 1 ]] || fail "an interactive terminal is required"

export AESTHETIC_CODE=1
export AESTHETIC_CODE_VERSION="$VERSION"
arguments=("--cwd" "$target_directory")
if [[ -n "$resume_thread" ]]; then arguments+=("--resume" "$resume_thread"); fi
if [[ -n "$initial_prompt" ]]; then arguments+=("--prompt" "$initial_prompt"); fi
exec node "$PROJECT_DIR/src/tui.mjs" "${arguments[@]}"

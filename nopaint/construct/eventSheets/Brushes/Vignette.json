				{
					"functionName": "VignetteRender",
					"functionDescription": "",
					"functionCategory": "",
					"functionReturnType": "none",
					"functionCopyPicked": false,
					"functionIsAsync": false,
					"functionParameters": [],
					"eventType": "function-block",
					"conditions": [],
					"actions": [
						{
							"id": "set-eventvar-value",
							"objectClass": "System",
							"sid": 894946810386145,
							"parameters": {
								"variable": "x",
								"value": "VignetteVehicle.X"
							}
						},
						{
							"id": "set-eventvar-value",
							"objectClass": "System",
							"sid": 377107314549564,
							"parameters": {
								"variable": "y",
								"value": "VignetteVehicle.Y"
							}
						},
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const data = main.globalImageData.data",
								"let x, y, dist, pma",
								"const radMinHard = localVars.radius - localVars.hardness",
								"",
								"for (let i = 0, len = data.length; i < len; i += 4)",
								"{",
								"\tx = (i / 4) % main.globalImageData.width",
								"\ty = Math.floor((i / 4) / main.globalImageData.height)",
								"\tdist = main.distance(x, y, localVars.x, localVars.y) ",
								"\t",
								"\tdata[i + 3] = Math.min(200, Math.floor((dist - localVars.hardness) / (radMinHard) * 255))",
								"\tpma = 255 * (data[i + 3] / 255)",
								"\tdata[i] = pma",
								"\tdata[i + 1] = pma",
								"\tdata[i + 2] = pma",

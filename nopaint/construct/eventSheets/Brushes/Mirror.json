						{
							"eventType": "block",
							"conditions": [],
							"actions": [
								{
									"type": "script",
									"language": "javascript",
									"script": [
										"const imageData = await runtime.objects.PaintingBuffer.getFirstInstance().getImagePixelData()",
										"const data = imageData.data",
										"",
										"const vertically = localVars.vertically",
										"const position = localVars.position",
										"",
										"if (vertically) {",
										"",
										"\tif (position > 127) {",
										"\t",
										"\t\t// Copy from left to right.",
										"\t\tfor (let x = imageData.width - 1; x > position; x -= 1) {",
										"\t\t\tfor (let y = 0; y < imageData.height; y += 1) {",
										"",
										"\t\t\t\t\t// To",
										"\t\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
										"",
										"\t\t\t\t\t// From",
										"\t\t\t\t\tconst b = main.getColorIndicesForCoord((position * 2) - (x), y, imageData.width)",
										"",
										"",
										"\t\t\t\t\t// Set a to b",
										"\t\t\t\t\tdata[a[0]] = data[b[0]]",
										"\t\t\t\t\tdata[a[1]] = data[b[1]]",
										"\t\t\t\t\tdata[a[2]] = data[b[2]]",
										"\t\t\t\t\tdata[a[3]] = data[b[3]]",
										"\t\t\t}",
										"\t\t}",
										"\t",
										"\t} else {",
										"\t",
										"\t\t// Copy from right to left.",
										"\t\tfor (let x = 0; x < position; x += 1) {",
										"\t\t\tfor (let y = 0; y < imageData.height; y += 1) {",
										"",
										"\t\t\t\t\t// To",
										"\t\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
										"",
										"\t\t\t\t\t// From",
										"\t\t\t\t\tconst b = main.getColorIndicesForCoord((position * 2) - (x), y, imageData.width)",
										"",
										"\t\t\t\t\t// Set a to b",
										"\t\t\t\t\tdata[a[0]] = data[b[0]]",
										"\t\t\t\t\tdata[a[1]] = data[b[1]]",
										"\t\t\t\t\tdata[a[2]] = data[b[2]]",
										"\t\t\t\t\tdata[a[3]] = data[b[3]]",
										"\t\t\t}",
										"\t\t}",
										"\t}",
										"\t",
										"} else { // horizontally",
										"\t",
										"\tif (position > 127) {",
										"\t",
										"\t\t// Copy from left to right.",
										"\t\tfor (let y = imageData.height - 1; y > position; y -= 1) {",
										"\t\t\tfor (let x = 0; x < imageData.width; x += 1) {",
										"",
										"\t\t\t\t\t// To",
										"\t\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
										"",
										"\t\t\t\t\t// From",
										"\t\t\t\t\tconst b = main.getColorIndicesForCoord(x, (position * 2) - (y), imageData.width)",
										"",
										"",
										"\t\t\t\t\t// Set a to b",
										"\t\t\t\t\tdata[a[0]] = data[b[0]]",
										"\t\t\t\t\tdata[a[1]] = data[b[1]]",
										"\t\t\t\t\tdata[a[2]] = data[b[2]]",
										"\t\t\t\t\tdata[a[3]] = data[b[3]]",
										"\t\t\t}",
										"\t\t}",
										"",
										"\t} else {",
										"\t",
										"\t\t// Copy from right to left.",
										"\t\tfor (let y = 0; y < position; y += 1) {",
										"\t\t\tfor (let x = 0; x < imageData.height; x += 1) {",
										"",
										"\t\t\t\t\t// To",
										"\t\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
										"",
										"\t\t\t\t\t// From",
										"\t\t\t\t\tconst b = main.getColorIndicesForCoord(x, (position * 2) - (y), imageData.width)",
										"",
										"\t\t\t\t\t// Set a to b",
										"\t\t\t\t\tdata[a[0]] = data[b[0]]",
										"\t\t\t\t\tdata[a[1]] = data[b[1]]",
										"\t\t\t\t\tdata[a[2]] = data[b[2]]",
										"\t\t\t\t\tdata[a[3]] = data[b[3]]",
										"\t\t\t}",
										"\t\t}",
										"\t}",
										"",
										"}",
										"",
										"runtime.objects.MirrorBuffer.getFirstInstance().loadImagePixelData(imageData)"
									]
								},

								{
									"type": "script",
									"language": "javascript",
									"script": [
										"const imageData = await runtime.objects.QuicksandBuffer.getFirstInstance().getImagePixelData()",
										"",
										"const data = imageData.data",
										"for (let i = 0, len = data.length; i < len; i += 4)",
										"{",
										"\tconst x = (i / 4) % imageData.width",
										"\tconst y = Math.floor((i / 4) / imageData.height)",
										"\tconst distance = Math.hypot(x - localVars.radius, y - localVars.radius)",
										"\tconst cutoff1 = localVars.radius * 0.6",
										"\tconst cutoff2 = localVars.radius * 0.9",
										"\t",
										"\tif (distance > cutoff1 && distance < cutoff2 && runtime.random() < (distance - cutoff1) / cutoff1) {",
										"\t  data[i] = 0",
										"\t  data [i + 1] = 0",
										"\t  data[i + 2] = 0",
										"\t  data[i + 3] = 0",
										"\t} else if (distance > cutoff2) {",
										"\t  data[i] = 0",
										"\t  data [i + 1] = 0",
										"\t  data[ i + 2] = 0",
										"\t  data[i + 3] = 0",
										"\t}",
										"}",
										"",
										"runtime.objects.QuicksandBuffer.getFirstInstance().loadImagePixelData(imageData)"
									]
								},

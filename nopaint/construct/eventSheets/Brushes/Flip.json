						{
							"id": "on-timer",
							"objectClass": "Clock",
							"sid": 260762556871801,
							"behaviorType": "Timer",
							"parameters": {
								"tag": "\"Flip\""
							}
						}
					],
					"actions": [
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const imageData = await runtime.objects.PaintingBuffer.getFirstInstance().getImagePixelData()",
								"const data = imageData.data",
								"",
								"const imageDataCopy = new ImageData(new Uint8ClampedArray(data), imageData.width, imageData.height)",
								"const dataCopy = imageDataCopy.data",
								"",
								"const vertically = localVars.vertically",
								"",
								"if (vertically) {",
								"",
								"\tfor (let x = 0; x < imageData.width; x += 1) {",
								"\t\tfor (let y = 0; y < imageData.height; y += 1) {",
								"\t",
								"\t\t\t\t// To",
								"\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
								"",
								"\t\t\t\t// From",
								"\t\t\t\tconst b = main.getColorIndicesForCoord(x, imageData.height - 1 - y, imageData.width)",
								"",
								"\t\t\t\t// Set a to b",
								"\t\t\t\tdata[a[0]] = dataCopy[b[0]]",
								"\t\t\t\tdata[a[1]] = dataCopy[b[1]]",
								"\t\t\t\tdata[a[2]] = dataCopy[b[2]]",
								"\t\t\t\tdata[a[3]] = dataCopy[b[3]]",
								"\t\t}",
								"\t}",
								"",
								"\t",
								"} else { // horizontally",
								"\t",
								"\tfor (let x = 0; x < imageData.width; x += 1) {",
								"\t\tfor (let y = 0; y < imageData.height; y += 1) {",
								"\t",
								"\t\t\t\t// To",
								"\t\t\t\tconst a = main.getColorIndicesForCoord(x, y, imageData.width)",
								"",
								"\t\t\t\t// From",
								"\t\t\t\tconst b = main.getColorIndicesForCoord(imageData.width - 1 - x, y, imageData.width)",
								"",
								"\t\t\t\t// Set a to b",
								"\t\t\t\tdata[a[0]] = dataCopy[b[0]]",
								"\t\t\t\tdata[a[1]] = dataCopy[b[1]]",
								"\t\t\t\tdata[a[2]] = dataCopy[b[2]]",
								"\t\t\t\tdata[a[3]] = dataCopy[b[3]]",
								"\t\t}",
								"\t}",
								"",
								"}",
								"",
								"runtime.objects.PaintingBuffer.getFirstInstance().loadImagePixelData(imageData)"
							]
						},

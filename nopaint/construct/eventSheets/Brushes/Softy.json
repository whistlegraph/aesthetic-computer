											"id": "set-default-color",
											"objectClass": "SoftCircleBuffer",
											"sid": 341578362721102,
											"disabled": true,
											"parameters": {
												"color": "rgbEx(100 - Painting.SnapshotRedAt(Leader.X, Leader.Y), 100 - Painting.SnapshotGreenAt(Leader.X, Leader.Y), 100 - Painting.SnapshotBlueAt(Leader.X, Leader.Y))"
											}
										},
										{
											"type": "script",
											"language": "javascript",
											"script": [
												"// Vary the calculated HSL by ~0.2",
												"const hsl = main.rgbToHsl(...runtime.objects.SoftCircleBuffer.getFirstInstance().colorRgb).map((v) => Math.min(Math.max(0, v + (-0.1 + runtime.random() * 0.2)), 1))",
												"localVars.h = hsl[0]",
												"localVars.s = hsl[1]",
												"localVars.l = hsl[2]",
												"",
												"// 30% of the time, randomize the hue.",
												"if (runtime.random() > 0.7) {",
												"\tlocalVars.h = runtime.random()",
												"}",
												"",
												"// 4/10 times, make the saturation very high or low.",
												"if (runtime.random() > 0.6) {",
												"\tif (runtime.random() > 0.5) {",
												"\t\tlocalVars.s = 1.0",
												"\t} else {",
												"\t\tlocalVars.s = 0.1",
												"\t}",
												"}",
												"",
												"// 3/10 times, make the brightness 0.5.",
												"if (runtime.random() > 0.7) {",
												"\tlocalVars.l = 0.5",
												"}"
											],
											"disabled": true
										},
										{
											"id": "set-default-color",
											"objectClass": "SoftCircleBuffer",
											"sid": 396682264048984,

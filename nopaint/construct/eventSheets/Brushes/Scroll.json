				},
				{
					"functionName": "ScrollRender",
					"functionDescription": "",
					"functionCategory": "",
					"functionReturnType": "none",
					"functionCopyPicked": false,
					"functionIsAsync": false,
					"functionParameters": [],
					"eventType": "function-block",
					"conditions": [],
					"actions": [
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const imageData = await runtime.objects.PaintingBuffer.getFirstInstance().getImagePixelData()",
								"const data = imageData.data",
								"const newImageData = new ImageData(imageData.width, imageData.height)",
								"const newData = newImageData.data",
								"",
								"const gap = localVars.gap",
								"const horizontal = localVars.horizontal",
								"const reverse = localVars.reverse",
								"",
								"let start = gap",
								"let dataIndex, newDataIndex",
								"",
								"// Copy from data to newData, taking the stride of pixels into account, based on the direction.",
								"",
								"if (horizontal) {",
								"",
								"\tif (reverse) { // Right",
								"\t",
								"\t\tfor (let x = 0; x < imageData.width; x += 1) {",
								"\t\t\tfor (let y = 0; y < imageData.height; y += 1) {",
								"\t\t\t\tdataIndex = main.getColorIndicesForCoord(x, y, imageData.width)",
								"\t\t\t\tnewDataIndex = main.getColorIndicesForCoord(start, y, imageData.width)",
								"",
								"\t\t\t\tnewData[newDataIndex[0]] = data[dataIndex[0]] ",
								"\t\t\t\tnewData[newDataIndex[1]] = data[dataIndex[1]]",
								"\t\t\t\tnewData[newDataIndex[2]] = data[dataIndex[2]]",
								"\t\t\t\tnewData[newDataIndex[3]] = data[dataIndex[3]]",
								"\t\t\t}",
								"\t\t\tstart = (start + 1) % imageData.width",
								"\t\t}",
								"\t\t",
								"\t} else { // Left",
								"\t",
								"\t\tfor (let x = 0; x < imageData.width; x += 1) {",
								"\t\t\tfor (let y = 0; y < imageData.height; y += 1) {",
								"\t\t\t\tlet dataIndex, newDataIndex",
								"",
								"\t\t\t\tdataIndex = main.getColorIndicesForCoord(imageData.width - 1 - x, y, imageData.width)",
								"\t\t\t\tnewDataIndex = main.getColorIndicesForCoord(imageData.width - 1 - start, y, imageData.width)",
								"",
								"\t\t\t\tnewData[newDataIndex[0]] = data[dataIndex[0]] ",
								"\t\t\t\tnewData[newDataIndex[1]] = data[dataIndex[1]]",
								"\t\t\t\tnewData[newDataIndex[2]] = data[dataIndex[2]]",
								"\t\t\t\tnewData[newDataIndex[3]] = data[dataIndex[3]]",
								"\t\t\t}",
								"\t\t\tstart = (start + 1) % imageData.width",
								"\t\t}",
								"\t\t",
								"\t}",
								"",
								"} else {",
								"",
								"\tif (reverse) { // Down",
								"\t",
								"\t\tfor (let y = 0; y < imageData.height; y += 1) {",
								"\t\t\tfor (let x = 0; x < imageData.width; x += 1) {",
								"\t\t\t\tdataIndex = main.getColorIndicesForCoord(x, y, imageData.width)",
								"\t\t\t\tnewDataIndex = main.getColorIndicesForCoord(x, start, imageData.width)",
								"\t\t\t\t",
								"\t\t\t\tnewData[newDataIndex[0]] = data[dataIndex[0]] ",
								"\t\t\t\tnewData[newDataIndex[1]] = data[dataIndex[1]]",
								"\t\t\t\tnewData[newDataIndex[2]] = data[dataIndex[2]]",
								"\t\t\t\tnewData[newDataIndex[3]] = data[dataIndex[3]]",
								"\t\t\t}",
								"\t\t\tstart = (start + 1) % imageData.height",
								"\t\t}",
								"\t",

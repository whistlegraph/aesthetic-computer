{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "question",
    "claim",
    "whyNow",
    "signals",
    "priorWorkChecked",
    "terms",
    "exclusions",
    "uncertainties"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 8, "maxLength": 140 },
    "question": { "type": "string", "minLength": 20, "maxLength": 500 },
    "claim": { "type": "string", "minLength": 20, "maxLength": 700 },
    "whyNow": { "type": "string", "minLength": 20, "maxLength": 700 },
    "signals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessedAt", "kind", "relevance"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "url": { "type": "string", "format": "uri" },
          "accessedAt": { "type": "string", "format": "date-time" },
          "kind": { "type": "string", "minLength": 2, "maxLength": 80 },
          "relevance": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "priorWorkChecked": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "terms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2, "maxLength": 80 }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    }
  }
}

% ac-paper-queue.sty — the draft-queue lane.
% A queue holds outgoing correspondence that is written but NOT sent.
% One cover (the ledger), then one page per message: an envelope block,
% an UNSENT stamp, any holds, and the body as it would be sent.
% Private, vault-side, never published. Generated by papers/bin/draft-queue.mjs.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ac-paper-queue}[2026/10/26 AC draft-queue lane]

\RequirePackage[top=0.9in,bottom=0.9in,left=1in,right=1in]{geometry}
\RequirePackage{fontspec}
\setmainfont{lmroman10-regular.otf}[
  BoldFont=lmroman10-bold.otf, ItalicFont=lmroman10-italic.otf,
  BoldItalicFont=lmroman10-bolditalic.otf]
\setsansfont{lmsans10-regular.otf}[
  BoldFont=lmsans10-bold.otf, ItalicFont=lmsans10-oblique.otf]
\setmonofont{lmmono10-regular.otf}[Scale=0.9]
\providecommand{\queuefontpath}{../../../system/public/type/webfonts/}
\newfontfamily\acbold{ywft-processing-bold}[Path=\queuefontpath,Extension=.ttf]
\newfontfamily\aclight{ywft-processing-light}[Path=\queuefontpath,Extension=.ttf]

\RequirePackage{xcolor}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\RequirePackage{microtype}
\RequirePackage{hyperref}
\RequirePackage{xurl}

\definecolor{acpink}{RGB}{180,72,135}
\definecolor{acpurple}{RGB}{120,80,180}
\definecolor{acdark}{RGB}{64,56,74}
\definecolor{acgray}{RGB}{119,119,119}
\definecolor{acwarn}{RGB}{176,96,40}
\definecolor{acenvelope}{RGB}{246,243,250}

\hypersetup{colorlinks=true,linkcolor=acpurple,urlcolor=acpurple}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.7em}
\setlist{itemsep=0.15em,topsep=0.2em,leftmargin=1.4em}
\linespread{1.08}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\small\sffamily\color{acgray}\queuetitlevalue}
\fancyfoot[R]{\small\sffamily\color{acgray}\thepage}

% ── cover ───────────────────────────────────────────────────────────
\newcommand{\queuetitlevalue}{Draft queue}
\newcommand{\queuetitle}[1]{\renewcommand{\queuetitlevalue}{#1}}
\newcommand{\queuecover}[3]{% #1 title  #2 dateline  #3 note
  {\acbold\fontsize{30}{34}\selectfont\color{acdark}#1\par}
  \vspace{0.3em}
  {\sffamily\large\color{acgray}#2\par}
  \vspace{0.8em}
  {\sffamily\color{acwarn}\bfseries #3\par}
  \vspace{1.2em}}

% ledger table is written by the generator (tabularx cannot sit inside \newenvironment)
\newcommand{\queuerow}[4]{#1 & \textbf{#2} & #3 & {\color{acwarn}#4} \\[0.3em]}

% ── one message ─────────────────────────────────────────────────────
% \queuemessage{n}{name}  then \envelope{...rows...}  then \holds{...}  then body
\newcommand{\queuemessage}[2]{%
  \clearpage
  {\acbold\fontsize{20}{24}\selectfont\color{acdark}\makebox[1.6em][l]{#1}#2\hfill
   \fcolorbox{acwarn}{white}{\sffamily\footnotesize\bfseries\color{acwarn}\, UNSENT \,}\par}
  \vspace{0.6em}}
\newtcolorbox{envelopebox}{colback=acenvelope,colframe=acenvelope,boxrule=0pt,arc=2pt,
  left=8pt,right=8pt,top=6pt,bottom=6pt}
\newcommand{\envrow}[2]{#1 & #2 \\}
\newcommand{\holds}[1]{%
  \begin{tcolorbox}[colback=white,colframe=acwarn,boxrule=0.6pt,arc=2pt,
    left=8pt,right=8pt,top=4pt,bottom=4pt]
  \sffamily\small\color{acwarn}\textbf{Hold before sending:} #1
  \end{tcolorbox}}
\newcommand{\bodyrule}{\par\vspace{0.2em}{\color{acgray}\rule{\linewidth}{0.4pt}}\par\vspace{0.4em}}

\endinput

# actv-watchdog.service — health check for the AC station (fired by timer).
# AUDIO_CHECK=0: a chat room is legitimately silent; only picture + process
# vitals apply.
[Unit]
Description=Aesthetic Computer TV watchdog check

[Service]
Type=oneshot
Environment=DISPLAY_NUM=:98 SINK=acsink UNIT=actv AUDIO_CHECK=0 SIZE=960x540
Environment=PROFILE_DIR=%h/.ac-rig-chrome
# /api/version is the same signal disk.mjs's update badge watches — any AC
# deploy restarts the station, so the badge never lingers on television.
Environment=RELOAD_URLS=https://aesthetic.computer/api/version
ExecStart=/bin/sh %h/actv/watchdog.sh

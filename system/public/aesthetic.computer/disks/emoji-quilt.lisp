(wipe 35 23 51)
(def patch (max 30 (floor (/ (min w h) 4))))
(def stitch (max 1 (floor (/ patch 24))))
(def size (max 1 (floor (/ patch 21))))
(repeat (ceil (/ h patch)) row
  (repeat (ceil (/ w patch)) col
    (def x (* col patch))
    (def y (* row patch))
    (def half (/ patch 2))
    (def motif (mod (+ col (* row 3) (floor (/ frame 72))) 4))
    (if (= (mod (+ col row) 2) 0) (ink 148 62 74) else (ink 20 89 102))
    (box (+ x stitch) (+ y stitch) (- patch stitch) (- patch stitch))
    (if (= (mod (+ col row) 2) 0) (ink 83 41 73) else (ink 31 56 87))
    (shape (+ x half) (+ y stitch) (+ x patch) (+ y half)
           (+ x half) (+ y patch) (+ x stitch) (+ y half))
    (ink 249 196 123)
    (box (+ x stitch stitch) (+ y stitch stitch) (* stitch 3) stitch)
    (box (- (+ x patch) (* stitch 4)) (- (+ y patch) (* stitch 3)) (* stitch 3) stitch)
    (def gx (- (+ x half) (* size 8)))
    (def gy (- (+ y half) (* size 8)))
    (if (= motif 0) (write (2s... "🫌" "🪼" "🌿" "🐚") gx gy "transparent" size))
    (if (= motif 1) (write (2s... "🛙" "🇧🇷" "🇯🇵" "🏴‍☠️") gx gy "transparent" size))
    (if (= motif 2) (write (2s... "🪋" "👩🏽‍🚀" "🌙" "🪐") gx gy "transparent" size))
    (if (= motif 3) (write (2s... "🫝" "🍓" "🧑🏿‍🌾" "🍄") gx gy "transparent" size))))

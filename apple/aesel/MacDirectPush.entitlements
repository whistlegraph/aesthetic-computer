<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The final signature of the Developer ID build: MacDirect.entitlements plus
     push. The restricted keys must match the embedded Developer ID profile
     (vault/aesel/AeselDirect.provisionprofile), so release-mac.sh applies them
     only after embedding it; the xcodebuild step keeps MacDirect.entitlements. -->
<plist version="1.0"><dict>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.application-identifier</key><string>FB5948YR3S.computer.aesthetic.aesel.native</string>
  <key>com.apple.developer.team-identifier</key><string>FB5948YR3S</string>
  <key>com.apple.developer.aps-environment</key><string>production</string>
</dict></plist>

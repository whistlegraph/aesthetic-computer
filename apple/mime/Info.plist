<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>MIME.ac</string>
  <key>CFBundleDisplayName</key><string>MIME.ac</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UIUserInterfaceStyle</key><string>Dark</string>
  <key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>UIAppFonts</key><array><string>Fonts/ComicRelief-Bold.ttf</string></array>
  <key>NSMicrophoneUsageDescription</key><string>Record your voice to make and edit work in MIME.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Turn your spoken instructions into text for your work.</string>
  <key>NSPhotoLibraryAddUsageDescription</key><string>Save your exported work to Photos.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Send your work to a nearby display.</string>
  <key>NSBonjourServices</key><array><string>_http._tcp</string></array>
  <!-- "made with" opens the creation app when it is installed. -->
  <key>LSApplicationQueriesSchemes</key><array><string>whistlegraph</string></array>
</dict>
</plist>

# MIME.ac on TestFlight. Signing and uploads use the same Admin key as AC,
# Whistlegraph, Oskiewar and Menu Band. First-time app creation needs an Apple
# ID session: Apple's public API does not support creating an apps resource.
require "shellwords"
require "yaml"

APP_DIR = File.expand_path("..", __dir__)
REPO_DIR = File.expand_path("../..", APP_DIR)
SETTINGS = YAML.load_file(File.join(APP_DIR, "project.yml")).fetch("settings").fetch("base")
VERSION = SETTINGS.fetch("MARKETING_VERSION").to_s
BUILD = SETTINGS.fetch("CURRENT_PROJECT_VERSION").to_s
BUNDLE = "computer.aesthetic.mime"
APP_NAME = "MIME.ac"
TESTER_GROUP = "MIME.ac Friends"
TEAM = "FB5948YR3S"
KEY_ID = "S4TQKG6U99"
ISSUER = "69a6de78-fa3c-47e3-e053-5b8c7c11a4d1"
KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{KEY_ID}.p8")
RELEASE_DIR = File.expand_path(ENV.fetch("MIME_RELEASE_DIR", "~/Library/Developer/Mime-Releases/#{VERSION}-#{BUILD}"))
IPA = File.expand_path(ENV.fetch("MIME_IPA", File.join(RELEASE_DIR, "export/Mime.ipa")))

def asc_key
  app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER, key_filepath: KEY_PATH, in_house: false)
end

def store_app
  Spaceship::ConnectAPI::App.find(BUNDLE)
end

platform :ios do
  desc "Create the app record using a terminal Apple ID login (once): FASTLANE_USER=<Apple ID> fastlane ios create"
  lane :create do
    asc_key
    if (app = store_app)
      UI.success("#{APP_NAME} already exists: #{app.id}")
      next
    end
    unless Spaceship::ConnectAPI::BundleId.find(BUNDLE)
      Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, identifier: BUNDLE, platform: "IOS")
    end
    # produce requires an Apple ID session; seeding an API token cannot replace it.
    sh("node", File.join(__dir__, "refresh-service-key.mjs"))
    Spaceship::ConnectAPI.token = nil
    produce(username: ENV["FASTLANE_USER"], app_identifier: BUNDLE,
            app_name: APP_NAME, app_version: VERSION, sku: "mime-ac",
            language: "en-US", platform: "ios", skip_devcenter: true)
  end

  desc "XcodeGen, archive Release with two compiler jobs, and export a signed IPA"
  lane :build do
    sh("node", File.join(APP_DIR, "../whistlegraph/bundle.mjs"))
    sh("xcodegen", "generate", "--spec", File.join(APP_DIR, "project.yml"), "--project", APP_DIR)
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{KEY_PATH.shellescape} " \
           "-authenticationKeyID #{KEY_ID} -authenticationKeyIssuerID #{ISSUER}"
    build_ios_app(project: File.join(APP_DIR, "Mime.xcodeproj"),
                  scheme: "Mime", configuration: "Release",
                  archive_path: File.join(RELEASE_DIR, "Mime.xcarchive"),
                  export_method: "app-store", export_team_id: TEAM,
                  # gym adds the API key to -exportArchive itself; passing it twice fails.
                  xcargs: "-jobs 2 #{auth}", export_xcargs: "-allowProvisioningUpdates",
                  output_directory: File.dirname(IPA), output_name: File.basename(IPA))
  end

  desc "Upload the signed IPA to TestFlight using the Apple API key"
  lane :upload do
    key = asc_key
    UI.user_error!("No app record yet. Run FASTLANE_USER=<Apple ID> fastlane ios create once.") unless store_app
    UI.user_error!("Missing #{IPA}; run fastlane ios build first.") unless File.file?(IPA)
    upload_to_testflight(api_key: key, app_identifier: BUNDLE, ipa: IPA,
                         skip_waiting_for_build_processing: true, distribute_external: false)
  end

  desc "Make the private tester group if needed, then submit this build for external beta review"
  lane :distribute do
    key = asc_key
    app = store_app
    UI.user_error!("Create the app record first") unless app
    unless app.get_beta_groups.any? { |g| g.name == TESTER_GROUP && !g.is_internal_group }
      app.create_beta_group(group_name: TESTER_GROUP, is_internal_group: false, public_link_enabled: false,
                            public_link_limit: 10_000, public_link_limit_enabled: false)
    end
    upload_to_testflight(api_key: key, app_identifier: BUNDLE, app_platform: "ios",
                         app_version: VERSION, build_number: BUILD,
                         distribute_only: true, distribute_external: true,
                         groups: [TESTER_GROUP], notify_external_testers: true,
                         submit_beta_review: true,
                         beta_app_description: "Watch everything people make across Aesthetic Computer, KidLisp and Whistlegraph, one piece per screen.",
                         beta_app_feedback_email: "mail@aesthetic.computer",
                         changelog: ENV.fetch("MIME_TEST_NOTES", "Swipe up through the network: paintings, KidLisp, pieces, Whistlegraphs and moods. Tap a piece's code (top left) to play with it; tap again to keep scrolling. Pieces play sound."))
  end

  desc "Add one external tester: fastlane ios invite email:<email> name:<first-name>"
  lane :invite do |options|
    email = options[:email].to_s.strip
    UI.user_error!("Provide email:<tester email>") if email.empty?
    asc_key
    app = store_app
    UI.user_error!("Create the app record first") unless app
    group = app.get_beta_groups(includes: "betaTesters").find { |g| g.name == TESTER_GROUP && !g.is_internal_group }
    UI.user_error!("Run fastlane ios distribute first, which makes #{TESTER_GROUP}") unless group
    if group.beta_testers.to_a.any? { |t| t.email.casecmp?(email) }
      UI.success("Tester is already in #{TESTER_GROUP}")
      next
    end
    tester = Spaceship::ConnectAPI::BetaTester.find(email: email)
    if tester
      group.add_beta_testers(beta_tester_ids: [tester.id])
    else
      attributes = {email: email}
      attributes[:firstName] = options[:name] if options[:name]
      Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [group.id], attributes: attributes)
    end
    UI.success("Tester added to #{TESTER_GROUP}; install access depends on an approved build.")
  end

  desc "Read App Store Connect state for this version and build"
  lane :status do
    asc_key
    if (app = store_app)
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: VERSION, build_number: BUILD, platform: "IOS").first
      UI.message("#{APP_NAME} #{app.id}: #{VERSION} (#{BUILD}) #{build&.build_beta_detail&.external_build_state || "not uploaded"}")
    else
      UI.important("No #{APP_NAME} app record yet; run FASTLANE_USER=<Apple ID> fastlane ios create once.")
    end
  end
end

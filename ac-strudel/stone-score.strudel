// STONE WATTAJETTA — @jeffrey / aesthetic.computer
// https://pat.aesthetic.computer/stone — for Will
// Instrumental reduction of pop/wattajetta/bin/render-wattajetta.mjs:
// original pentatonic cursor, E/G/A/D roots, four stone mutations, water gallop.
// 72-bar edit at 132 BPM; the current club renderer stretches this to 144 bars.
// Synth stone approximates the bells; no FEM audio, vocals or found FX here.
await import('https://pat.aesthetic.computer/s')
setcpm(132/4)

// SCORE — one cycle = one 4/4 bar. The cursor never resets between bars.
// Change moves or pool to rewrite the tune; keep first strikes for an instant start.
const pool = ['e4', 'g4', 'a4', 'b4', 'd5', 'e5']
const moves = [1, 1, 0, 2, -1, 1, -2, 1, 0, 1, 2, -1, 0, -2, 1, 1, -1]
let cursor = 2, direction = 1, step = 0
const lines = [], roots = [], water = [], necklaces = []
for (let bar = 0; bar < 72; bar++) {
  const mutation = Math.floor(bar / 18)
  roots.push(['e1', 'g1', 'a1', 'd2'][Math.floor((bar % 18) / 2) % 4])
  const line = []
  for (let eighth = 0; eighth < 8; eighth++) {
    if (step > 0 && (step % 11 === 0 || step % 29 === 0)) direction *= -1
    cursor += moves[(step + mutation * 3) % moves.length] * direction
    while (cursor < 0 || cursor >= pool.length) {
      if (cursor < 0) cursor = -cursor
      if (cursor >= pool.length) cursor = 2 * (pool.length - 1) - cursor
      direction *= -1
    }
    // Sparse opening, fuller later; every bar speaks on its downbeat.
    line.push(eighth === 0 || (step * 7) % 11 < [5, 7, 8, 10][mutation] ? pool[cursor] : '~')
    step++
  }
  lines.push('[' + line.join(' ') + ']')
  // Rising drips on the source's 1.75 / 3.25 / 3.75 beat positions.
  const drips = Array(16).fill('~')
  for (const slot of [7, 13, 15]) drips[slot] = ['e3', 'g3', 'a3', 'b3', 'd4'][(bar + slot) % 5]
  if (bar === 0) drips[0] = 'e3'
  water.push('[' + drips.join(' ') + ']')
  // E(5/7/9/11,16), rotated five steps per bar: a changing percussion necklace.
  const hits = [5, 7, 9, 11][mutation]
  necklaces.push('[' + Array.from({length:16}, (_,i) =>
    (((i + bar * 5) % 16) * hits) % 16 < hits ? 'b6' : '~').join(' ') + ']')
}
const tune = mini(lines.join(' ')).note().slow(72)
const bass = mini('<' + roots.join(' ') + '>').note()
const drips = mini(water.join(' ')).note().slow(72)
const shaker = mini(necklaces.join(' ')).note().slow(72)

// KICK — continuous floor; ac_kick sweeps a sine from ~126 Hz to 43 Hz.
// .n(0..1) changes pitch attack + decay. All parts below are active.
$: note("e1*4").s('ac_kick').n(.35).gain(.85).release(.04)

// SUB — the source's two-bar root sequence, centered beneath the moving field.
// A quiet octave adds definition on smaller speakers.
$: bass.s('ac_sine').attack(.01).release(.08).gain(.32).lpf(190)
$: bass.transpose(12).s('ac_sine').attack(.015).release(.06).gain(.1).lpf(260)

// GALLOP — four offbeat sine stabs; the sub already sounds on beat one.
$: bass.transpose(12).struct("[~ x]*4").s('ac_sine')
  .attack(.005).decay(.1).sustain(.05).release(.035).gain(.5)

// STONE LINE — asymmetric cursor; 18 bars per mutation, 72 before repeating.
// .n = strike brightness/ring. Long and short breaths drift past bar boundaries.
$: tune.s('ac_stone').n(perlin.slow(13).range(.15,.85))
  .release(sine.slow(7.3).range(.08,1.3)).gain(.38)
  .pan(sine.slow(13).range(.2,.8)).room(.25)._pianoroll()

// WATER — upward 0.55x-to-1x pitch chirps, from the renderer's bloop gesture.
// .n changes droplet length; delay and pan move independently of the stone.
$: drips.s('ac_water').n(perlin.slow(11)).gain(.32)
  .pan(sine.slow(17)).delay(.16).delaytime(.227).release(.05)

// BOWLS — lower stone bodies under each pair of bars. Different breathing clock.
$: bass.transpose(24).s('ac_stone').n(.16).attack(.004)
  .release(1.4).gain(sine.slow(19).range(.1,.2)).room(.4)

// BACKBEAT / SHAKERS — synthetic metallic percussion, no sample downloads.
// Backbeat on 2 & 4; the rotating necklace is audible from the opening.
$: note("~ e4 ~ e4").s('ac_glass').n(.85)
  .attack(.001).decay(.04).sustain(0).release(.025).gain(.38).hpf(700)
$: shaker.s('ac_glass').n(.9).attack(.001).decay(.018).sustain(0)
  .release(.012).gain(.12).hpf(4500).pan(sine.slow(23).range(.25,.75))

// Will: mute any complete $: block with /* ... */; leave the SCORE setup intact.
// Every part is enabled. The bass and kick start immediately; backbeat/gallop
// enter on their first rhythmic slot. No long intro or silent probability gate.
// Notes repeat after 72 bars; 7.3/11/13/17/19/23-cycle motion keeps changing.
// More voices + controls: https://pat.aesthetic.computer/source
// Standalone copy/paste: https://pat.aesthetic.computer/stone/paste

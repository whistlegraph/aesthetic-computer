# The sample bank is derived — bin/slice.mjs rebuilds it from the
# whistlegraph mirror plus the ElevenLabs mp3s below. Media, not source.
# (out/ is already covered repo-wide by `pop/**/out/`.)
samples/

# ffmpeg's 48k decodes of the ElevenLabs mp3s — regenerated by slice.mjs.
vox/*-48k.wav

# But the ElevenLabs renders themselves ARE tracked: they cost real money,
# /api/say caches by content hash at exactly this path, and the alignment
# sidecars are what the slicer cuts against. ~140 KB total.
!vox/*.mp3
!vox/*.mp3.hash
!vox/*.mp3.alignment.json

# The sung bank — bin/sing.mjs regenerates every WAV from samples/ through
# bin/sing.py (WORLD). Derived media, and cached by an args hash, so a
# rebuild is deterministic and cheap. The manifest IS tracked: it records
# what note each word was sung to and what librosa.pyin measured back.
sung/*.wav
!sung/.manifest.json

# v5: the harvest from the OTHER eleven cult-tagged whistlegraph posts.
# alt/raw and alt/wav are downloaded media (36 MB) and alt/samples is
# derived from them by alt/cut.py — all reproducible from the mirror plus
# the scripts and the receipt, so only those are tracked.
alt/raw/
alt/wav/
alt/txt/
alt/samples/
alt/.venv-whisper/
!alt/harvest.json
!alt/*.py

# The source whistlegraph mp4 — re-fetchable from the assets mirror.
source/

# the reference generator builds these locally
reference/ref
reference/*.f32
reference/*.wav

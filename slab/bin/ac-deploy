#!/usr/bin/env node
// ac-deploy — the one command any harness (Claude, Codex, Aesel) calls to
// ship lith, and the only thing it needs to know about deploying.
//
//   ac-deploy                  deploy the knot's main to lith, then prove it
//   ac-deploy --verify         only prove what production is serving
//   ac-deploy aesel            release Aesel alone from the knot's main
//   ac-deploy aesel --verify   only prove what Aesel release is served
//   ac-deploy products         ship only the private products (the vault's
//                              pushed main) onto the core lith already runs:
//                              pack, install, restart lith, purge the edge —
//                              under a minute, no core reset, no npm install
//
// Aesel is released on its own clock. A lith deploy no longer packs it, so
// shipping a site change never re-releases Aesel, and releasing Aesel never
// moves lith's checkout: `ac-deploy aesel` packs aesel/ from the knot's main
// in a scratch directory on lith and swaps the tarballs and manifest into
// system/public, manifest last.
//
// Deploying lith is @jeffrey's alone, so before anything moves this checks
// that it is him: the git identity must be @jeffrey AND his git credentials
// must reach the knot (a copied checkout without his key fails the second).
// Production serves the knot's main and nothing else, so local main must be
// pushed, and private products ship from the vault's pushed main through a
// clean clone (see cleanVault); deploy.fish is always told DEPLOY_BRANCH=main, which makes this
// safe from a worktree or a feature branch. Afterwards it compares the bytes
// production serves against the commit it shipped.
import { execFileSync, spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { existsSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { join } from "node:path";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { workspace, releaseState } from "../../toolchain/private-products.mjs";

const ROOT = resolve(dirname(realpathSync(fileURLToPath(import.meta.url))), "../..");
const SITE = "https://aesthetic.computer";
const verifyOnly = process.argv.includes("--verify");
const aeselOnly = process.argv[2] === "aesel";
const productsOnly = process.argv[2] === "products";

const git = (...args) => execFileSync("git", ["-C", ROOT, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const say = (mark, text) => console.log(`${mark} ${text}`);
const fail = (text) => { say("✕", text); process.exit(1); };

function whoami() {
  const name = git("config", "user.name");
  if (!/@jeffrey\b/.test(name)) fail(`lith deploys are @jeffrey's; git identity here is "${name || "unset"}"`);
  try { git("ls-remote", "--exit-code", "origin", "main"); }
  catch { fail("your git credentials can't reach the knot (origin) — deploys need @jeffrey's key"); }
  say("✓", `${name} · knot reachable`);
}

// Private products ship from the vault's pushed main, never from the shared
// vault checkout: other sessions leave work in progress there, and a checkout
// that is behind its origin would roll production's products back. This keeps
// a clean sparse clone of products/ in ~/.cache/ac-deploy/vault, resets it to
// origin/main for each deploy, and borrows objects from the shared vault so
// refreshing is cheap.
// The vault's pushed main lives on whatever remote its main tracks (GitHub
// here). Its `origin` points at a sibling Mac that is often asleep, and a
// fetch against that hangs rather than fails.
function vaultUpstream(repo) {
  try {
    const [remote] = execFileSync("git", ["-C", repo, "rev-parse", "--abbrev-ref", "main@{upstream}"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim().split("/");
    return remote || "origin";
  } catch { return "origin"; }
}

function cleanVault() {
  const shared = workspace(ROOT).vault;
  const clone = process.env.AC_PRODUCTS_VAULT || join(homedir(), ".cache", "ac-deploy", "vault");
  const vgit = (...args) => execFileSync("git", ["-C", clone, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
  const upstream = vaultUpstream(shared);
  if (!existsSync(join(clone, ".git"))) {
    const url = execFileSync("git", ["-C", shared, "remote", "get-url", upstream], { encoding: "utf8" }).trim();
    say("→", `cloning the vault's pushed main into ${clone} (first deploy on this Mac)`);
    const run = spawnSync("git", ["clone", "-q", "--no-checkout", "--reference-if-able", shared, url, clone], { stdio: "inherit" });
    if (run.status !== 0) fail("could not clone the vault");
  }
  // Only products/ ships, so only products/ is checked out (~60 MB, not GBs).
  vgit("sparse-checkout", "set", "products");
  // An older clone may have been made from the sleeping sibling; repoint it.
  const wanted = execFileSync("git", ["-C", shared, "remote", "get-url", upstream], { encoding: "utf8" }).trim();
  if (vgit("remote", "get-url", "origin") !== wanted) vgit("remote", "set-url", "origin", wanted);
  vgit("fetch", "-q", "origin", "main");
  vgit("reset", "-q", "--hard", "origin/main");
  vgit("clean", "-qfdx");
  const unshipped = execFileSync("git", ["-C", shared, "status", "--porcelain", "--untracked-files=all", "--", "products"], { encoding: "utf8" }).trim();
  if (unshipped) say("·", `${unshipped.split("\n").length} uncommitted product file(s) in ${shared} stay local — only the vault's pushed main ships`);
  process.env.AC_PRODUCTS_VAULT = clone;
  return releaseState(workspace(ROOT, clone));
}

// `sha` is the core commit production should be serving: the knot's main
// after a full deploy, or whatever lith already runs after a products release.
async function verify(sha) {
  const get = async (path) => {
    const response = await fetch(`${SITE}${path}?t=${Date.now()}`, { headers: { "cache-control": "no-cache" } });
    if (!response.ok) throw new Error(`${path} answered ${response.status}`);
    return response.text();
  };
  let ok = true;
  const served = (await get("/.commit-ref")).trim();
  if (served === sha) say("✓", `serving ${sha.slice(0, 10)}`);
  else { ok = false; say("✕", `serving ${served.slice(0, 10) || "nothing"}, expected ${sha.slice(0, 10)}`); }
  const vault = process.env.AC_PRODUCTS_VAULT || workspace(ROOT).vault;
  const remote = process.env.AC_PRODUCTS_VAULT ? "origin" : vaultUpstream(vault);
  const expectedProducts = process.env.AC_PRODUCTS_REVISION
    || (execFileSync("git", ["-C", vault, "fetch", "-q", remote, "main"]), execFileSync("git", ["-C", vault, "rev-parse", `${remote}/main`], { encoding: "utf8" }).trim());
  const products = (await get("/.products-ref")).trim();
  if (products === expectedProducts) say("✓", `products ${products.slice(0, 10)}`);
  else { ok = false; say("✕", `products ${products.slice(0, 10)}, expected ${expectedProducts.slice(0, 10)}`); }
  // Aesel ships separately (`ac-deploy aesel`); here it is only reported.
  const want = JSON.parse(git("show", `${sha}:aesel/package.json`)).version;
  const have = JSON.parse(await get("/aesel.json")).version;
  say("·", have === want ? `Aesel ${have}` : `Aesel ${have} served · main has ${want} · release it with ac-deploy aesel`);
  return ok;
}

// The Aesel release as served: the manifest's version is main's, and the
// tarball it names hashes to what the manifest says.
async function verifyAesel(sha) {
  const want = JSON.parse(git("show", `${sha}:aesel/package.json`)).version;
  const manifest = await (await fetch(`${SITE}/aesel.json?t=${Date.now()}`, { headers: { "cache-control": "no-cache" } })).json();
  let ok = true;
  if (manifest.version === want) say("✓", `aesel.json ${manifest.version}`);
  else { ok = false; say("✕", `aesel.json ${manifest.version}, expected ${want}`); }
  const tarball = Buffer.from(await (await fetch(`${SITE}${manifest.tarball}?t=${Date.now()}`, { headers: { "cache-control": "no-cache" } })).arrayBuffer());
  const sum = createHash("sha256").update(tarball).digest("hex");
  if (sum === manifest.sha256 && tarball.length === manifest.bytes) say("✓", `${manifest.tarball} ${(tarball.length / 1024).toFixed(0)} KB · sha256 matches`);
  else { ok = false; say("✕", `${manifest.tarball} does not match its manifest`); }
  return ok;
}

// The same key deploy.fish uses: the vault's plaintext copy, or its GPG copy
// opened with the passphrase the slab daemon hands over.
function lithKey() {
  const key = join(ROOT, "aesthetic-computer-vault/home/.ssh/id_rsa");
  if (existsSync(key)) return { key, done: () => {} };
  const gpg = `${key}.gpg`;
  if (!existsSync(gpg)) fail(`no lith SSH key at ${key}`);
  const passphrase = execFileSync(join(ROOT, "slab/bin/ac-passphrase"), ["vault", "600"], { encoding: "utf8" }).trim();
  if (!passphrase) fail("no vault passphrase");
  const dir = mkdtempSync(join(tmpdir(), "ac-lith-")), file = join(dir, "key");
  const out = spawnSync("gpg", ["--batch", "--pinentry-mode", "loopback", "--passphrase-fd", "0", "--decrypt", gpg], { input: passphrase, encoding: "buffer" });
  if (out.status !== 0) fail(`could not decrypt ${gpg}`);
  writeFileSync(file, out.stdout, { mode: 0o600 });
  return { key: file, done: () => rmSync(dir, { recursive: true, force: true }) };
}

// The products alone, onto the core lith already serves: the same pack →
// stage → snapshot → install path deploy.fish takes, minus the core reset,
// the three npm installs and the Spaces env. A product change is a static
// file or a backend module, so lith restarts (seconds) and the edge is purged.
// Returns the core commit lith runs, which is what production should serve.
function releaseProducts(revision) {
  const host = process.env.LITH_HOST || "lith.aesthetic.computer";
  const { key, done } = lithKey();
  const ssh = (script) => spawnSync("ssh", ["-i", key, "-o", "BatchMode=yes", `root@${host}`, "bash", "-s"], { input: script, encoding: "utf8", stdio: ["pipe", "pipe", "inherit"] });
  try {
    const core = ssh("git -C /opt/ac rev-parse HEAD").stdout.trim();
    if (!/^[0-9a-f]{40}$/.test(core)) fail("could not read the commit lith is running");
    // The products must fit the core that is live, not the knot's newest.
    const check = spawnSync("node", ["toolchain/private-products.mjs", "release-check", core], { cwd: ROOT, encoding: "utf8", env: process.env });
    if (check.status !== 0) fail(`these products do not fit lith's core ${core.slice(0, 10)}: ${check.stderr.trim().split("\n").pop()} — run a full ac-deploy`);
    const dir = mkdtempSync(join(tmpdir(), "ac-products-")), tgz = join(dir, "products.tgz");
    try {
      const pack = spawnSync("node", ["toolchain/private-products.mjs", "pack", tgz], { cwd: ROOT, stdio: ["ignore", "ignore", "inherit"], env: process.env });
      if (pack.status !== 0) fail("could not pack the products");
      const stage = ssh("mktemp -d /tmp/ac-products.XXXXXXXX").stdout.trim();
      if (!/^\/tmp\/ac-products\.[A-Za-z0-9]+$/.test(stage)) fail("could not make a staging directory on lith");
      const scp = spawnSync("scp", ["-q", "-i", key, tgz, join(ROOT, "toolchain/private-products.mjs"), join(ROOT, "private-products.json"), `root@${host}:${stage}/`], { stdio: "inherit" });
      if (scp.status !== 0) fail("could not upload the products to lith");
      const run = `env AC_CORE_ROOT=/opt/ac AC_PRODUCTS_MANIFEST=${stage}/private-products.json node ${stage}/private-products.mjs`;
      const install = ssh(`set -e
mkdir ${stage}/incoming && tar -xzf ${stage}/products.tgz -C ${stage}/incoming
${run} snapshot ${stage}/previous
if ! ${run} install ${stage}/incoming; then ${run} install ${stage}/previous; echo "install failed; the previous products are back" >&2; exit 1; fi
systemctl restart lith`);
      if (install.status !== 0) fail("installing the products on lith failed");
      say("✓", `products ${revision.slice(0, 10)} installed on core ${core.slice(0, 10)} · lith restarted · rollback snapshot ${stage}/previous`);
    } finally { rmSync(dir, { recursive: true, force: true }); }
    return core;
  } finally { done(); }
}

// The same purge deploy.fish does, with the same credential search: the
// process env first, then the vault env files; Global API Key before token.
async function purgeEdge() {
  const vault = join(ROOT, "aesthetic-computer-vault");
  const files = ["lith/.env", ".devcontainer/envs/devcontainer.env", "oven/deploy.env", "nanos/conductor.env", "help/deploy.env", "at/deploy.env"].map((f) => join(vault, f));
  const lookup = (name) => {
    if (process.env[name]) return process.env[name];
    for (const file of files) {
      if (!existsSync(file)) continue;
      const line = readFileSync(file, "utf8").split("\n").find((l) => new RegExp(`^(export )?${name}=`).test(l));
      if (line) return line.replace(new RegExp(`^(export )?${name}=`), "").trim().replace(/^["']|["']$/g, "");
    }
    return "";
  };
  const email = lookup("CLOUDFLARE_EMAIL"), apiKey = lookup("CLOUDFLARE_API_KEY"), token = lookup("CLOUDFLARE_API_TOKEN");
  const headers = { "content-type": "application/json", ...(email && apiKey ? { "X-Auth-Email": email, "X-Auth-Key": apiKey } : token ? { Authorization: `Bearer ${token}` } : {}) };
  if (!headers["X-Auth-Key"] && !headers.Authorization) { say("·", "no Cloudflare credentials — edge not purged (its TTL still bounds staleness)"); return; }
  for (const zoneName of ["aesthetic.computer", "prompt.ac"]) {
    try {
      const zones = await (await fetch(`https://api.cloudflare.com/client/v4/zones?name=${zoneName}`, { headers })).json();
      const zone = zones.result?.[0]?.id;
      if (!zone) { say("·", `purge ${zoneName}: zone not found`); continue; }
      const purge = await (await fetch(`https://api.cloudflare.com/client/v4/zones/${zone}/purge_cache`, { method: "POST", headers, body: JSON.stringify({ purge_everything: true }) })).json();
      say(purge.success ? "✓" : "·", `purge ${zoneName}: ${purge.success ? "ok" : JSON.stringify(purge.errors)}`);
    } catch (error) { say("·", `purge ${zoneName}: ${error.message}`); }
  }
}

// Packed on lith from a `git archive` of aesel/ at the commit, never from the
// served checkout, so lith's tree and every other site stay where they are.
// aesel/web's node_modules are kept per lockfile hash and reused.
function releaseAesel(sha) {
  const host = process.env.LITH_HOST || "lith.aesthetic.computer";
  const script = `set -euo pipefail
SHA=${sha}; R=/tmp/aesel-release-$SHA; PUB=/opt/ac/system/public; KEEP=/opt/ac-aesel-release
cd /opt/ac && git fetch -q origin main && git cat-file -e "$SHA^{commit}"
rm -rf "$R" && mkdir -p "$R/system/public" "$KEEP"
git archive "$SHA" aesel | tar -x -C "$R"
LOCK=$(git show "$SHA:aesel/web/package-lock.json" | sha256sum | cut -c1-16)
# Named node_modules inside a per-lockfile folder: esbuild finds its native
# binary by walking up to a directory called exactly that.
rm -rf "$KEEP"/node_modules-*
if [ ! -d "$KEEP/$LOCK/node_modules" ]; then
  (cd "$R/aesel/web" && npm ci --no-audit --no-fund --loglevel=error) && mkdir -p "$KEEP/$LOCK" && mv "$R/aesel/web/node_modules" "$KEEP/$LOCK/node_modules"
fi
ln -sfn "$KEEP/$LOCK/node_modules" "$R/aesel/web/node_modules"
# pack.mjs writes beside the copy it packs: $R/system/public.
node "$R/aesel/bin/pack.mjs" > "$R/pack.log" || { cat "$R/pack.log"; exit 1; }
head -1 "$R/pack.log"
for f in aesel.tar.gz easel.tar.gz aesel.json easel.json; do test -s "$R/system/public/$f" || { echo "pack made no $f"; exit 1; }; done
for f in aesel.tar.gz easel.tar.gz aesel.json easel.json; do
  cp "$R/system/public/$f" "$PUB/.$f.new" || exit 1
  mv -f "$PUB/.$f.new" "$PUB/$f" || exit 1
done
rm -rf "$R"
`;
  const { key, done } = lithKey();
  try {
    const run = spawnSync("ssh", ["-i", key, "-o", "BatchMode=yes", `root@${host}`, "bash", "-s"], { input: script, stdio: ["pipe", "inherit", "inherit"] });
    if (run.status !== 0) fail(`the Aesel pack on ${host} exited ${run.status}`);
  } finally { done(); }
}

whoami();
git("fetch", "-q", "origin", "main");
const sha = git("rev-parse", "origin/main");

if (aeselOnly) {
  if (!verifyOnly) {
    const version = JSON.parse(git("show", `${sha}:aesel/package.json`)).version;
    say("→", `releasing Aesel ${version} from ${sha.slice(0, 10)} (lith's checkout stays put)`);
    releaseAesel(sha);
  }
  process.exit((await verifyAesel(sha)) ? 0 : 1);
}

if (productsOnly) {
  if (verifyOnly) process.exit((await verify(sha)) ? 0 : 1);
  const revision = cleanVault();
  process.env.AC_PRODUCTS_REVISION = revision;
  say("→", `shipping products ${revision.slice(0, 10)} to lith (its core stays as served)`);
  const core = releaseProducts(revision);
  await purgeEdge();
  process.exit((await verify(core)) ? 0 : 1);
}

if (!verifyOnly) {
  process.env.AC_PRODUCTS_REVISION = cleanVault();
  const ahead = git("rev-list", "--count", "origin/main..main");
  if (ahead !== "0") fail(`local main is ${ahead} commit(s) ahead of the knot — push first; production only serves what the knot has`);
  say("→", `deploying ${sha.slice(0, 10)} to lith`);
  const run = spawnSync("fish", ["lith/deploy.fish"], { cwd: ROOT, stdio: "inherit", env: { ...process.env, DEPLOY_BRANCH: "main" } });
  if (run.status !== 0) fail(`lith/deploy.fish exited ${run.status}`);
}

process.exit((await verify(sha)) ? 0 : 1);

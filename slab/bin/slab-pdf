#!/usr/bin/env bash
# slab-pdf <file.pdf> [more.pdf …] — open PDFs in macOS Preview.
#
# Slab previously routed this command through its chromeless PDFKit reader,
# including an automatic dark-reader inversion. Preview is now the seat-wide
# default so papers retain their authored colors and familiar PDF controls.
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "usage: slab-pdf <file.pdf> [more.pdf …]" >&2
    exit 1
fi

files=()
for f in "$@"; do
    if [ ! -f "$f" ]; then
        echo "slab-pdf: no such file: $f" >&2
        exit 1
    fi
    # realpath isn't guaranteed on stock macOS bash paths — resolve by hand.
    abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
    files+=("$abs")
done

exec /usr/bin/open -a Preview "${files[@]}"

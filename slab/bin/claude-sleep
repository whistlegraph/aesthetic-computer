#!/bin/bash
# Unified sleep control for the slab workflow.
#
#   claude-sleep awake    # stay awake until explicitly released
#   claude-sleep auto     # release the manual hold and allow normal sleep
#   claude-sleep now      # release the manual hold and sleep immediately
#   claude-sleep work     # temporary keep-awake for an agent turn
#   claude-sleep idle     # automatic sleep, unless manually held awake
#   claude-sleep restore  # reapply a saved manual hold at login/wake
#   claude-sleep status   # show actual sleep state and manual preference
#
# Requires passwordless sudo for /usr/bin/pmset. See slab install.sh.

set -eu
PMSET=${SLAB_PMSET:-/usr/bin/pmset}
SLAB_HOME=${SLAB_HOME:-$HOME/.local/share/slab}
HOLD="$SLAB_HOME/state/stay-awake"

# Serialize the preference and pmset together: a finishing turn must not
# clear SleepDisabled after a concurrent manual enable has succeeded.
mkdir -p "$SLAB_HOME/state" "$SLAB_HOME/logs"
if [[ "${1:-}" != "--locked" ]]; then
    /usr/bin/lockf -k -t 10 "$SLAB_HOME/state/sleep-control.lock" "$0" --locked "$@" 2>&1
    exit $?
fi
shift

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$SLAB_HOME/logs/sleep-control.log"; }
set_sleep() {
    local detail
    if detail=$(sudo -n "$PMSET" -a disablesleep "$1" 2>&1); then
        return 0
    fi
    # stdout is consumed by the menubar; do not silently discard failures.
    echo "Could not change sleep protection: $detail"
    log "${command}: failed to set SleepDisabled=$1"
    return 1
}
sleep_now() {
    sudo -n "$PMSET" sleepnow 2>&1 \
        || osascript -e 'tell application "System Events" to sleep' 2>&1
}

command=${1:-status}
case "$command" in
    awake)
        was_held=0
        [[ ! -f "$HOLD" ]] || was_held=1
        touch "$HOLD"
        if ! set_sleep 1; then
            [[ "$was_held" == 1 ]] || rm -f "$HOLD"
            exit 1
        fi
        log "awake: manual hold enabled"
        echo "awake (SleepDisabled=1, StayAwake=1)"
        ;;
    auto)
        set_sleep 0
        rm -f "$HOLD"
        log "auto: manual hold released"
        echo "auto (SleepDisabled=0, StayAwake=0)"
        ;;
    now)
        set_sleep 0
        rm -f "$HOLD"
        log "now: explicit sleep, manual hold released"
        sleep_now
        ;;
    work)
        set_sleep 1
        log "work: temporary sleep protection enabled"
        ;;
    idle)
        if [[ -f "$HOLD" ]]; then
            log "idle: sleep skipped, manual hold enabled"
            echo "staying awake (manual hold)"
            exit 0
        fi
        set_sleep 0
        log "idle: automatic sleep"
        sleep_now
        ;;
    restore)
        if [[ -f "$HOLD" ]]; then
            set_sleep 1
            log "restore: manual hold reapplied"
        fi
        ;;
    status)
        state=$("$PMSET" -g | awk '/SleepDisabled/{print $2; exit}')
        echo "SleepDisabled=${state:-0}"
        if [[ -f "$HOLD" ]]; then echo "StayAwake=1"; else echo "StayAwake=0"; fi
        ;;
    *)
        echo "usage: $0 [awake|auto|now|work|idle|restore|status]" >&2
        exit 1
        ;;
esac

local Notes = require("../src/shared/Notes")
local Holds = require("../src/shared/Holds")
local checks = 0
local function check(value, message) assert(value, message); checks += 1 end
check(Notes.index("C") == 1 and Notes.index("v") == 2, "AC key mapping")
check(Notes.index("f") == 6 and Notes.index("w") == 7, "natural/sharp mapping")
check(Notes.index("Unknown") == nil, "unmapped input ignored")
check(math.abs(Notes.frequency(10, 4) - 440) < 0.001, "concert A4")
check(math.abs(Notes.frequency(1, 4) - 261.625565) < 0.001, "C4 tuning")
check(Notes.frequency(1, 5) == 2 * Notes.frequency(1, 4), "octaves double frequency")
check(math.abs(Notes.speed(8, 4) - 1) < 0.001, "sample G4 reference")
check(not pcall(Notes.frequency, 0, 4), "invalid index rejected")
check(not pcall(Notes.frequency, 1, 7), "octave bounds")
check(Notes.command("  NOTEpat ") == "notepat", "prompt normalizes whitespace/case")
check(Notes.command("notepat; anything") == nil, "prompt exact match")
local h = Holds.new()
check(h:press("keyboard", 1), "first source starts voice")
check(not h:press("keyboard", 1), "key repeat ignored")
check(not h:press("finger1", 1), "shared pad does not duplicate voice")
check(h:release("keyboard") == nil and h.counts[1] == 1, "keyboard release preserves held touch")
check(h:release("finger1") == 1 and h.counts[1] == nil, "final release stops voice")
check(h:release("finger1") == nil, "duplicate release harmless")
h:press("a", 1); h:press("b", 4); h:press("c", 4)
check(#h:clear() == 2 and next(h.sources) == nil and next(h.counts) == nil, "focus loss clears all held voices")
check(h:press("a", 1), "new note works after focus reset")
print("Notepat: " .. checks .. " logic checks passed")

    "ReplicatedStorage": {
      "ACUI": {
        "$path": "../shared/UI.luau",
        "Glyphs": {
          "$path": "../shared/Glyphs.luau"
        },
        "Unifont": {
          "$path": "../shared/Unifont.luau"
        }
      },
      "ShoveAnimation": {
        "$path": "../shared/ShoveAnimation.luau"
      },
      "GrenadeMath": {
        "$path": "../shared/GrenadeMath.luau"
      },
      "BlastFX": {
        "$path": "../shared/BlastFX.luau"
      }
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    }
  }

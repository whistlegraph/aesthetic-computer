local arena = game:GetService("ServerScriptService"):FindFirstChild("Arena")
assert(arena and arena:IsA("Script"), "server entry missing")
assert(game.StarterPlayer.StarterPlayerScripts:FindFirstChild("ArenaClient"), "client missing")
local Match = require(arena.Match)
local World = require(arena.World)
local Combat = require(arena.Combat)
local checks = 0
local function check(value, message) assert(value, message); checks += 1 end
local alive = function() return true end
local m = Match.new()
check(m:join(11), "first join")
check(not m:join(11), "duplicate rejected")
m:tick(0, alive)
check(m.phase == "Lobby", "one player must wait")
m:join(22); m:join(33); m:tick(1, alive)
check(m.phase == "Battle" and m.fighters[1] == 11 and m.fighters[2] == 22 and m.queue[1] == 33, "FIFO pairing")
check(m:canAttack(11, 1), "attack available immediately when paired")
check(m.deadline == 61, "full sixty seconds begins at pairing")
m:tick(6, alive); check(m.phase == "Battle", "battle starts")
check(m:canAttack(11, 6), "fighter attacks")
check(not m:canAttack(33, 6), "spectator rejected")
check(not m:canAttack(11, 6.5, 6), "cooldown enforced")
check(m:canAttack(11, 8, 6), "cooldown expires")
m:tick(7, function(id) return id == 22 end)
check(m.phase == "Result" and m.winner == 22, "ring out or disconnect awards opponent")
check(not m:canAttack(22, 8), "no result attacks")
m:tick(12, alive); check(m.phase == "Lobby" and #m.fighters == 0, "returns to lobby")
m:leave(33); check(#m.queue == 0, "leave queue")
local function duel()
    local d = Match.new(); d:join(1); d:join(2); d:tick(0, alive); d:tick(5, alive); return d
end
local d = duel(); d:tick(6, function() return false end)
check(d.phase == "Result" and d.winner == nil, "simultaneous elimination draws")
d = duel(); d:tick(65, alive)
check(d.phase == "Result" and d.winner == nil, "timeout draws")
d = Match.new(); d:join(1); d:join(2); d:tick(0, alive); d:tick(1, function(id) return id == 1 end)
check(d.phase == "Result" and d.winner == 1, "immediate battle disconnect")
local world = World.build()
check(World.build() == world, "world build idempotent")
check(world.Ring.Anchored and world.Ring.Size == Vector3.new(112, 2, 112), "ring geometry")
check(world.LobbySpawn:IsA("SpawnLocation") and world.LobbySpawn.Neutral, "safe spawn")
check(world.QueuePad:FindFirstChildOfClass("ProximityPrompt") == nil, "queue needs no keypress")
check(World.onPad(world.QueuePad,world.QueuePad.Position+Vector3.new(0,3,0)), "standing on pad queues")
check(not World.onPad(world.QueuePad,world.QueuePad.Position+Vector3.new(6,3,0)), "stepping off cancels")
check(not World.onPad(world.QueuePad,world.QueuePad.Position+Vector3.new(0,10,0)), "high above pad is outside queue")
check((World.lobby - World.starts[1]).Magnitude > 40, "lobby separated from ring")
local state = require(arena.Controller).start()
task.wait(0.3)
check(state:GetAttribute("Phase") == "Lobby", "real controller heartbeat starts in lobby")
check(state:GetAttribute("QueueCount") == 0, "real queue starts empty")
check(game.ReplicatedStorage.ArenaAction:IsA("RemoteEvent"), "action transport exists")
check(require(arena.Controller).start() == state, "controller cannot double start")
local origin, facing = Vector3.zero, Vector3.new(0, 0, -1)
check(Combat.impulse(origin, facing, Vector3.new(0, 0, -5), 2) == Vector3.new(0, 16, -84), "forward shove scales with mass")
check(Combat.impulse(origin, facing, Vector3.new(0, 0, 5), 2) == nil, "cannot shove behind")
check(Combat.impulse(origin, facing, Vector3.new(0, 0, -9), 2) == nil, "cannot shove beyond reach")
check(Combat.impulse(origin, facing, origin, 2) == nil, "overlap does not normalize zero")
check(Combat.impulse(origin, facing, Vector3.new(0, 10, -1), 2) == nil, "vertical distance counts")
local Bot = require(arena.Bot)
check(Bot.destination(Vector3.new(52, 3, 0), Vector3.new(53, 3, 0)) == Vector3.new(0, 3, 0), "bot retreats from edge")
check(Bot.destination(Vector3.new(0, 3, 0), Vector3.new(3, 3, 0)) == Vector3.new(0, 3, 0), "bot holds shove range")
local dummy = Bot.create()
check(dummy.Humanoid.Health > 0 and dummy.HumanoidRootPart.Anchored, "real dummy rig created ready for countdown")
check(dummy.Parent == game.ServerStorage, "unpaired dummy cannot obstruct the ring")
dummy.Parent = workspace
dummy.HumanoidRootPart.Anchored = false
dummy.HumanoidRootPart:SetNetworkOwner(nil)
Bot.step(dummy.HumanoidRootPart, dummy.Humanoid, Vector3.new(-9, 6, 0))
check(dummy.Humanoid.WalkSpeed == 18, "bot movement configured")
local ShoveAnimation = require(game.ReplicatedStorage.ShoveAnimation)
local joints = ShoveAnimation.joints(dummy)
check(#joints == 2, "dummy has two animatable shoulders")
check(ShoveAnimation.pose(0.2) == 1 and ShoveAnimation.pose(0.6) == 0, "shove extends and recovers")
ShoveAnimation.apply(joints, 0.2)
check(joints[1].joint.Transform ~= joints[1].base, "shove pose changes real shoulder transforms")
ShoveAnimation.apply(joints, 0.6)
check(joints[1].joint.Transform == joints[1].base, "recovery restores original shoulder transforms")
print("SIMULATION_RUNNING", game:GetService("RunService"):IsRunning())
dummy:Destroy()
d = Match.new(); d:join(11); d:join(Bot.ID); d:tick(0, alive); d:tick(5, alive)
check(d:canAttack(Bot.ID, 6), "dummy uses shared attack rules")
d:tick(6, function(id) return id == Bot.ID end)
check(d.winner == Bot.ID and d.phase == "Result", "dummy can win")
local Updates = require(arena.Updates)
local notice = Instance.new("Folder")
check(not Updates.accept(notice, {version = 4}, 5), "old releases ignored")
check(not Updates.accept(notice, {version = "6"}, 5), "malformed release ignored")
check(Updates.accept(notice, {version = 6}, 5), "new release reaches UI state")
check(not Updates.accept(notice, {version = 6}, 5), "duplicate release ignored")
notice:Destroy()
local UI = require(game.ReplicatedStorage.ACUI)
local label = UI.label(nil, {Text = "QUEUE"})
check(label.Text == "QUEUE" and label.Font == Enum.Font.Code, "shared UI component constructs")
label:Destroy()
local painted = UI.bitmapLabel(nil, {Text = "SHOVE F", Size = UDim2.fromOffset(240, 58)})
check(painted.TextTransparency == 1 and #painted.ACLettering:GetChildren() > 0, "actual AC glyphs render as pixels")
painted.Text = "☃"
check(painted.TextTransparency == 1, "Unifont handles missing AC glyph")
painted.Text = "😀"
check(painted.TextTransparency == 0, "upper plane keeps native fallback")
painted:Destroy()
local unicode=require(game.ReplicatedStorage.ACUI.Unifont)
check(unicode.glyph(0x2603).width==16, "Unifont symbol metrics")
check(unicode.glyph(0x4E2D).width==16, "Unifont wide CJK metrics")
check(unicode.glyph(0x00E6)~=nil and unicode.glyph(0x00F8)~=nil and unicode.glyph(0x00E5)~=nil, "Danish glyph coverage")
local Bridge=require(arena.MediaBridge)
check(Bridge.validate({schemaVersion=1,revision=1,items={{approved=true,imageAssetId="85149608937004"}}})[1]=="85149608937004", "approved image manifest")
check(Bridge.validate({schemaVersion=1,revision=1,items={{approved=true,imageAssetId="https://bad.example"}}})==nil, "arbitrary image URLs rejected")
check(Bridge.validate({schemaVersion=1,revision=1,items={{approved=false,imageAssetId="123"}}})==nil, "unapproved images rejected")
local media,revision=Bridge.fetch()
check(#media>=1 and revision>=1, "live AC manifest HTTP fetch")
local stick=require(arena.Avatars).create("Test",Color3.new(0,1,1))
check(stick:GetAttribute("ACStick") and stick.HumanoidRootPart.Transparency==1, "custom hidden physics rig")
check(stick.Torso["Right Hip"]:IsA("Motor6D"), "stick joints animate")
local visuals=0
for _,p in stick:GetChildren() do if p.Name=="StickVisual" then check(p.Massless and not p.CanCollide,"stick cosmetics do not change collisions"); visuals+=1 end end
check(visuals>=10,"stick silhouette built")
stick:Destroy()
local GM=require(game.ReplicatedStorage.GrenadeMath)
check(GM.aim(Vector3.zero)==nil and GM.aim("bad")==nil, "invalid grenade aim rejected")
check(GM.aim(Vector3.new(10,5,0))==Vector3.new(1,0,0), "grenade aim normalized")
check(GM.blast(Vector3.zero,Vector3.new(21,0,0))==nil, "blast radius enforced")
check(GM.blast(Vector3.zero,Vector3.new(2,0,0)).X>GM.blast(Vector3.zero,Vector3.new(18,0,0)).X, "blast force falls with distance")
local bombs=require(arena.Grenades).new(function() end)
bombs:throw(Vector3.new(0,5,0),Vector3.new(20,5,0),0,1)
check(#bombs.active==1 and bombs.active[1].label.Text=="1.5", "grenade spawns with visible fuse")
bombs:tick(0.5,2); check(#bombs.active==0, "old round grenades cleared")
local launch=GM.velocity(Vector3.new(0,5,0),Vector3.new(100,5,0),workspace.Gravity)
check(math.abs(launch.X*0.5-22)<0.001, "long aim is capped at short lob range")
check(launch.Y^2/(2*workspace.Gravity)<7, "lob apex stays below seven studs above hand")
check(GM.runSpeed==24, "player speed tuning")
local inherited=GM.velocity(Vector3.new(0,5,0),Vector3.new(20,5,0),workspace.Gravity,Vector3.new(24,0,0))
check(inherited.X>GM.velocity(Vector3.new(0,5,0),Vector3.new(20,5,0),workspace.Gravity).X, "running momentum carries into throw")
check((GM.position(Vector3.zero,Vector3.new(10,20,0),100,0.2)-Vector3.new(2,2,0)).Magnitude<0.001, "shared client server ballistic position")
local impacts=0
local contactBombs=require(arena.Grenades).new(function() impacts+=1 end)
contactBombs:throw(Vector3.new(0,5,0),Vector3.new(20,5,0),0,1)
contactBombs:tick(0.9,1)
check(impacts==1 and #contactBombs.active==0, "ground contact explodes before fuse, even across a slow frame")
contactBombs:tick(2,1)
check(impacts==1, "contact cannot explode twice")
contactBombs:throw(Vector3.new(0,500,0),Vector3.new(20,500,0),0,1)
contactBombs:tick(1.6,1)
check(impacts==2, "missed contact retains fallback fuse")
local fx=require(game.ReplicatedStorage.BlastFX).create(Vector3.new(0,2,0),GM.radius)
check(#fx:GetChildren()==33 and fx.Sphere.CanCollide==false, "explosion sphere and 32 ring segments are visual only")
fx:Destroy()
print("ARENA_TEST_PASS", checks)
return {ok = true, checks = checks, placeId = game.PlaceId, version = game.PlaceVersion}

; Fía — a soft pink heart that says Fia, a dancing girl and her little fwends
; orbiting in 3D, the camera rolling, tilting and zooming to her face.
; A hand translation of wgDuram v18 (JavaScript, 27,581 characters) into
; KidLisp with pools, for kidlisp/PIECE-IL.md. Same drawing calls, same
; renderer; closures became global transform state plus small functions.

; a unit random: KidLisp's random gives integers
(later rnd01 (/ (random 1000000) 1000000))
; ---- time and the camera, once a frame --------------------------------
(def tt 0) (def tc 0) (def kc 0) (def th 0) (def cT 1) (def sT 0)
(def zm 1) (def pit 0) (def cP 1) (def sP 0) (def gh 1) (def uu 1) (def gfloor 1)
(def zk 0) (def Zz 1) (def fcx 0) (def fcy 0) (def ocx 0) (def ocy 0)
(def rl 0) (def kp 0) (def cr 1) (def sr 0) (def hw 1) (def hh 1)
(now tt (/ frame 60)) (now tc (* tt 0.6))
(now kc (* 0.5 (exp (- 0 (/ (mod (* tt 1000) 250) 140)))))
(now th (* tt 0.2)) (now cT (cos th)) (now sT (sin th))
(now zm (+ 1 (* 0.15 (sin (* tt 0.17))))) (now pit (* 0.3 (sin (* tt 0.11)))) (now cP (cos pit)) (now sP (sin pit))
(now gh (* (min (* height 0.34) (* width 0.58)) zm)) (now uu (/ gh 20)) (now gfloor (min (- height (* uu 2.2)) (- height 8)))
(def zk0 0) (now zk0 (- 0.5 (* 0.5 (cos (+ (* tt 0.75) 1))))) (now zk (* zk0 zk0 (- 3 (* 2 zk0)))) (now Zz (+ 1 (* 2.6 zk)))
(now fcx (+ (/ width 2) (* (sin (* tc 2)) uu 0.25)))
(now fcy (- gfloor (* 17.2 uu) (* kc uu 0.5) (* (abs (sin (* tc 2))) uu 0.3)))
(now ocx fcx) (now ocy (+ fcy (* (- (* height 0.45) fcy) zk)))
(now rl (* (+ 0.09 (* 0.05 zk)) (sin (+ (* tt 0.13) 0.5)))) (now kp (* (+ 0.18 (* 0.1 zk)) (sin (+ (* tt 0.11) 1))))
(now cr (cos rl)) (now sr (sin rl)) (now hw (/ width 2)) (now hh (/ height 2))

; ---- the squash transform (a figure turning on a vertical axis) ---------
(def sax 0) (def sc0 1) (def ss0 0) (def sz 0) (def sshade 1) (def sgy 0) (def spy 1) (def sal 1) (def sc 1)
(later squash ax c0 s0 zz shade gy py al
  (now sax ax) (now ss0 s0) (now sz zz) (now sshade shade) (now sgy gy) (now spy py) (now sal al)
  (now sc0 c0) (now sc (* (sign (+ c0 0.0000001)) (max 0.06 (abs c0)))))
(later nosquash (squash 0 1 0 0 1 0 1 1))
; squash a point, then project it through the camera (roll + keystone)
(def cxo 0) (def cyo 0)
(later cam x y
  (def mx (+ sax (* (- x sax) sc) (* sz ss0)))
  (def my (+ sgy (* (- y sgy) spy)))
  (def rx (- (+ ocx (* (- mx fcx) Zz)) hw))
  (def ry (- (+ ocy (* (- my fcy) Zz)) hh))
  (def rx2 (* rx (+ 1 (/ (* kp ry) height))))
  (now cxo (round (+ hw (* rx2 cr) (- 0 (* ry sr)))))
  (now cyo (round (+ hh (* rx2 sr) (* ry cr)))))
(later cs v (max 1 (round (* v Zz))))
(later thick th (if (> th 0) (cs th) else (if (> Zz 1.5) (ceil Zz) else 1)))
; shaded ink: the squash's shade and alpha ride on every colour
(later ci r g b a
  (if (= sshade 1) (if (= sal 1) (ink r g b a) else (ink r g b (* a sal))) else (ink (* r sshade) (* g sshade) (* b sshade) (* a sal))))
(later ck r g b (ci r g b 255))
(later cl x1 y1 x2 y2 th
  (cam x1 y1) (def ax cxo) (def ay cyo) (cam x2 y2)
  (line ax ay cxo cyo (thick th)))
(later cb x y bw bh
  (if (> bw bh)
    (cam x (+ y (/ bh 2))) (def ax cxo) (def ay cyo) (cam (+ x bw) (+ y (/ bh 2))) (line ax ay cxo cyo (cs bh)) else (cam (+ x (/ bw 2)) y) (def ax cxo) (def ay cyo) (cam (+ x (/ bw 2)) (+ y bh)) (line ax ay cxo cyo (cs bw))))
(later cc x y rad (cam x y) (oval cxo cyo (cs (max 1 (round (* rad (abs sc))))) (cs (max 1 (round (* rad spy))))))
(later co x y rx ry (cam x y) (oval cxo cyo (cs (max 1 (round (* rx (abs sc))))) (cs (max 1 (round (* ry spy))))))


  (def by (+ y0 oy (round (* (sin (+ (* tc 2) (* ii 1.2))) size))))
  (def lx (+ x0 ox (* ii cw)))
  (if (= ii 1)
    (def px (+ lx (round (* cw 0.5)))) (def sw (max 2 (round (* size 1.6))))
    (def lean (round (* size 0.5 (sin (* tc 2.5)))))
    (cb (- px (floor (/ sw 2))) (+ by (rr 3 size)) sw (rr 6 size))
    (cl (+ (- px (rr 1.2 size)) lean) (+ by (rr 1.6 size)) (+ px (rr 1.2 size) lean) (- by (rr 0.2 size)) (max 2 (rr 1.3 size))) else (if (= ii 0)
      (cb lx by tw (rr 9 size)) (cb lx by (rr 4.8 size) tw) (cb lx (+ by (rr 4.2 size)) (rr 3.6 size) tw) else
      (cb lx (+ by (rr 2 size)) (rr 4.8 size) tw) (cb lx (+ by (rr 4.6 size)) (rr 4.8 size) tw)
      (cb lx (+ by (rr 7.6 size)) (rr 4.8 size) (rr 1.4 size)) (cb lx (+ by (rr 4.6 size)) tw (rr 4.4 size))
      (cb (- (+ lx (rr 4.8 size)) tw) (+ by (rr 2 size)) tw (rr 7 size)))))
(later fia x0 y0 size ex ey
  (repeat 6 kk (def dd (- 5 kk)) (repeat 3 ii (letter dd ii (+ x0 (* ex dd)) (+ y0 (* ey dd)) size))))


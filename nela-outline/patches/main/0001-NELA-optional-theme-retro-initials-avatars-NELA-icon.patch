+import type { DefaultTheme } from "styled-components";
+
+/**
+ * Apply NELA's monospace, green and cyan palette to either color scheme.
+ * Semantic colors and document formatting remain supplied by the base theme.
+ *
+ * @param base the resolved light or dark theme.

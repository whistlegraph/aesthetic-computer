@@ -0,0 +1,38 @@
+import type { Context } from "koa";
+import env from "@server/env";
+import { loadPublicShare } from "@server/commands/shareLoader";
+import { cachedCard, siteName } from "@server/utils/openGraph";
+import { getTeamFromContext } from "@server/utils/passport";
+
+/**
+ * Serve the Open Graph card for a published share, or the site card.
+ *
+ * A card for a share is drawn only when loadPublicShare finds a published
+ * share containing the document, so private titles never reach a card.
+ * Missing or private shares fall back to the site card rather than a 404,
+ * keeping previews tidy without saying whether a share exists.
+ */
+export const renderOpenGraphCard = async (ctx: Context) => {
+  const site = siteName();
+  const host = ctx.state?.rootShare ? ctx.hostname : new URL(env.URL).host;
+  let title = process.env.OG_CARD_TITLE || "Wiki";
+
+  const { shareId, documentSlug } = ctx.params;
+  if (shareId) {
+    try {
+      const team = await getTeamFromContext(ctx, { includeOAuthState: false });
+      const { document, collection } = await loadPublicShare({
+        id: shareId,
+        documentId: documentSlug,
+        teamId: team?.id,
+      });
+      title = document?.title || collection?.name || title;
+    } catch (_err) {
+      // Not a published share: fall through to the site card.
+    }
+  }
+
+  ctx.type = "image/png";
+  ctx.set("Cache-Control", "public, max-age=3600");
+  ctx.body = cachedCard({ title, site, host });
+};

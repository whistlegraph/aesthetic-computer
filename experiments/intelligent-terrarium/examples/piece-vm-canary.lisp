(piece
  (jump main)

  (label branch)
  (triangle3 back origin stem wing 76 220 255)
  (line3 back origin stem 255 92 188)
  (less more one depth)
  (jump-if more children)
  (return)

  (label children)
  (push depth)
  (sub depth depth one)

  (push-transform)
  (translate stem.x stem.y stem.z)
  (rotate-z turn-left)
  (rotate-y yaw)
  (call branch)
  (pop-transform)

  (push-transform)
  (translate stem.x stem.y stem.z)
  (rotate-z turn-right)
  (rotate-x pitch)
  (call branch)
  (pop-transform)

  (pop depth)
  (return)

  (label main)
  (vec3 origin 0 0 0)
  (vec3 stem (ratio 3 8) 0 0)
  (vec3 wing (ratio 3 16) (ratio 1 10) (ratio 1 20))
  (constant one 1)
  (constant depth 6)
  (constant turn-left (ratio 1 11))
  (constant turn-right (ratio -1 9))
  (constant yaw (ratio 1 37))
  (constant pitch (ratio 1 43))
  (constant gx 3)
  (constant gy 3)
  (constant advance 6)
  (constant scene-x (ratio -3 5))
  (constant scene-y (ratio -1 4))
  (constant scene-z (ratio 1 4))
  (constant camera 2)
  (constant memory-zero 0)
  (constant speed (ratio 1 256))
  (load8 tick memory-zero)
  (add tick tick one)
  (store8 memory-zero tick)
  (mul phase tick speed)

  (clear back 5 8 18)
  (glyph back 65 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 67 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 32 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 80 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 73 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 69 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 67 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 69 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 86 gx gy 240 248 255)
  (add gx gx advance)
  (glyph back 77 gx gy 240 248 255)

  (perspective camera)
  (identity)
  (translate scene-x scene-y scene-z)
  (rotate-y phase)
  (call branch)
  (swap)
  (halt))
